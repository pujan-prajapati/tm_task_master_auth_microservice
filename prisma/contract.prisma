// use prisma-8

enum Role {
    USER
    ADMIN
}

model User {
    id Int @id @default(autoincrement())
    name String
    username String @unique
    hash_password String
    email String @unique
    phone String @unique
    avatar String?
    role Role @default(USER)
    is_active Boolean @default(true)
    refresh_tokens RefreshToken[]

    created_at temporal.CreatedAt
    updated_at temporal.UpdatedAt
}

model RefreshToken {
    id Int @id @default(autoincrement())
    token String @unique
    user_id Int
    expires_at DateTime

    created_at temporal.CreatedAt
    updated_at temporal.UpdatedAt

    user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
    @@index([user_id])
}